# ---------------------------------------------------------------
# Innes Eye & Visioncare Centre – environment configuration
# Copy to .env and fill in. NEVER commit .env or real secrets.
# ---------------------------------------------------------------
APP_NAME="Innes Eye & Visioncare Centre"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Accra
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Production: APP_ENV=production, APP_DEBUG=false, FORCE_HTTPS=true, SESSION_SECURE_COOKIE=true
FORCE_HTTPS=true
# Comma-separated proxy IPs if behind a load balancer / reverse proxy (or * to trust all)
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local PC: SQLite, a single file at database/database.sqlite (created by `php artisan migrate`).
# Leave DB_DATABASE commented out, otherwise Laravel looks for a different file.
DB_CONNECTION=sqlite
# DB_JOURNAL_MODE=wal   # lets DB Browser for SQLite stay open while the site saves

# Live server (e.g. Hostinger): MySQL 8.0+ with a user that can only access this database.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=innes
# DB_USERNAME=innes
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Mail: "log" writes emails to storage/logs/laravel.log for local testing.
# In production use smtp (or another supported transport) with real credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Application features ---
FEATURE_CUSTOMER_ACCOUNTS=true

# Online payments with Paystack (shop + appointment booking fees). Get the keys from
# dashboard.paystack.com -> Settings -> API Keys & Webhooks. Test keys start with pk_test_/sk_test_.
# Never commit the secret key. The shop and payment buttons stay hidden until the secret key is set.
FEATURE_SHOP=true
FEATURE_APPOINTMENT_PAYMENTS=true
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS

# SMS to customers. SMS_DRIVER: log (PC – texts go to storage/logs/laravel.log), arkesel, hubtel,
# twilio, or empty (off). The sender ID (max 11 characters) must be approved by the provider.
SMS_DRIVER=log
SMS_SENDER_ID=InnesEye
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Shows a "demo content" banner on the public site. Set false only after all demo content is replaced.
SHOW_DEMO_NOTICE=true
UPLOADS_DISK=public
UPLOAD_MAX_KB=10240

# --- First administrator (optional; used by `php artisan innes:create-admin --from-env`) ---
# Fill in, run the command once, then DELETE these values from .env.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator

# Local development only: password for demo staff/customer accounts created by the demo seeder.
DEMO_USER_PASSWORD=Demo-Password-2026

VITE_APP_NAME="${APP_NAME}"
