# ---------------------------------------------------------------
# Innes Eye & Visioncare Centre – environment configuration
# Copy to .env and fill in. NEVER commit .env or real secrets.
# ---------------------------------------------------------------
APP_NAME="Innes Eye & Visioncare Centre"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Accra
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Production: APP_ENV=production, APP_DEBUG=false, FORCE_HTTPS=true, SESSION_SECURE_COOKIE=true
FORCE_HTTPS=true
# Comma-separated proxy IPs if behind a load balancer / reverse proxy (or * to trust all)
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0+ (or compatible). Use a least-privilege user that can only access this database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=innes
DB_USERNAME=innes
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Mail: "log" writes emails to storage/logs/laravel.log for local testing.
# In production use smtp (or another supported transport) with real credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Application features ---
FEATURE_CUSTOMER_ACCOUNTS=true
# Shows a "demo content" banner on the public site. Set false only after all demo content is replaced.
SHOW_DEMO_NOTICE=true
UPLOADS_DISK=public
UPLOAD_MAX_KB=2048

# --- First administrator (optional; used by `php artisan innes:create-admin --from-env`) ---
# Fill in, run the command once, then DELETE these values from .env.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator

# Local development only: password for demo staff/customer accounts created by the demo seeder.
DEMO_USER_PASSWORD=Demo-Password-2026

VITE_APP_NAME="${APP_NAME}"
