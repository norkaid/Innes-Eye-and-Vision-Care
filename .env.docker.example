# Settings for running the site with Docker. Copy to .env.docker and edit.
# .env.docker holds secrets: it is never committed to Git.

APP_NAME="Innes Eye & Visioncare Centre"
# production = real site (no demo data). Use local to try it out with demo data (see SEED_DEMO_DATA).
APP_ENV=production
APP_DEBUG=false
# The address people type in the browser, e.g. http://localhost:8080 or https://inneseye.com
APP_URL=http://localhost:8080
# Leave empty: a key is created automatically on first start and kept in the storage volume.
APP_KEY=
APP_TIMEZONE=Africa/Accra
# true only when the site is served over HTTPS (e.g. with the https profile / a real domain).
FORCE_HTTPS=false
SESSION_SECURE_COOKIE=false
SESSION_DRIVER=database
CACHE_STORE=database
LOG_CHANNEL=stderr
LOG_LEVEL=warning
# Needed behind the optional Caddy HTTPS proxy.
TRUSTED_PROXIES=*

# Load sample content once (only works with APP_ENV=local). Demo logins use DEMO_USER_PASSWORD.
SEED_DEMO_DATA=false
DEMO_USER_PASSWORD=Demo-Password-2026
SHOW_DEMO_NOTICE=false

# Database (the "db" service). Choose your own passwords.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=innes
DB_USERNAME=innes
DB_PASSWORD=change-this-database-password
MYSQL_DATABASE=innes
MYSQL_USER=innes
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Online payments (Paystack). Test keys while testing; live keys for real money.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
FEATURE_SHOP=true
FEATURE_APPOINTMENT_PAYMENTS=true

# SMS (Arkesel). Sender ID: max 11 letters/numbers, no spaces, approved by Arkesel.
SMS_DRIVER=log
SMS_SENDER_ID=InnesEye
ARKESEL_API_KEY=

# Email (e.g. Gmail with an app password, or a Hostinger mailbox).
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Innes Eye & Visioncare Centre"

# Optional HTTPS profile: your domain name (must point at this machine).
DOMAIN=
